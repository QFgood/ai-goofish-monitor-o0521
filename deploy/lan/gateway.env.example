# Example only. scripts/lan.py creates .lan/gateway.env (0600).
# Single quotes preserve bcrypt dollar signs in Compose's env-file parser.
LAN_BIND_IP='192.168.9.202'
LAN_PORT='8000'
GATEWAY_USERNAME='lanadmin'
GATEWAY_PASSWORD_HASH='<generated-bcrypt-hash>'
APP_IMAGE='ghcr.io/usagi-org/ai-goofish@sha256:<installed-image-digest>'
APP_CONTAINER_NAME='ai-goofish-monitor-app'
APP_SHM_SIZE='1073741824'
APP_LOG_MAX_SIZE='10m'
APP_LOG_MAX_FILE='3'
