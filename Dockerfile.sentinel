# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend-builder
WORKDIR /web-ui
COPY web-ui/package*.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --strict-ssl=true
COPY web-ui/ .
RUN npm run build
# Assemble a small source bundle before the Chromium runtime stage. One final
# COPY avoids repeated large filesystem snapshots with Docker's vfs driver.
COPY src /bundle/src
COPY prompts/base_prompt.txt prompts/macbook_criteria.txt /bundle/prompts/
COPY spider_v2.py /bundle/spider_v2.py
COPY static /bundle/static
COPY config.json.example /bundle/config.json.example
RUN cp -a /dist /bundle/dist

FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 RUNNING_IN_DOCKER=true RUN_HEADLESS=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright TZ=Asia/Shanghai HOME=/home/sentinel
COPY requirements-runtime.txt ./
RUN --mount=type=secret,id=proxy_ca --mount=type=secret,id=proxy_bundle \
    if [ -f /run/secrets/proxy_bundle ]; then export PIP_CERT=/run/secrets/proxy_bundle SSL_CERT_FILE=/run/secrets/proxy_bundle; fi; \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir -r requirements-runtime.txt \
    && apt-get update && apt-get install -y --no-install-recommends tini libzbar0 tzdata \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 sentinel && useradd --uid 1000 --gid 1000 --create-home sentinel \
    && mkdir -p /app/data /app/state /app/logs /app/images /app/jsonl /app/price_history /app/prompts \
    && chown -R sentinel:sentinel /app /home/sentinel
COPY --from=frontend-builder --chown=sentinel:sentinel /bundle/ /app/
USER sentinel
EXPOSE 8000
ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "src.app"]
